# Funscript Player – Einstellungen für docker-compose.yml
# Einmal kopieren:  cp .env.example .env   – danach nur noch die .env bearbeiten
# (ein neues Update überschreibt deine .env nie, nur diese Vorlage).

# --- Adresse ---------------------------------------------------------------
# Player unter https://<PLAYER_HOST>.<DOMAIN>
DOMAIN=example.com
PLAYER_HOST=handy

# --- Anmeldung im Player (leer = keine; dann hinter einem Reverse Proxy oder nur im Heimnetz betreiben) ---
AUTH_USER=
AUTH_PASS=

# --- Stash -----------------------------------------------------------------
# Am besten direkt über das Docker-Netz, z. B. http://Stash:9999 (Containername)
STASH_URL=https://stash.example.com
# Nur nötig, wenn Stash eine Anmeldung hat
STASH_API_KEY=
# 1 = selbstsigniertes Zertifikat bei Stash akzeptieren
STASH_INSECURE=

# --- Medienordner ------------------------------------------------------------
# Wird zu /media/Filme; weitere Ordner in der docker-compose.yml unter volumes ergänzen
MEDIA_FILME=/srv/media/filme
# MEDIA_DOWNLOADS=/srv/downloads
# MEDIA_VR=/srv/media/vr

# --- HQ-Stream (Intel-Grafik) -----------------------------------------------
# vaapi = Intel-Grafik, cpu = Prozessor, leer = automatisch
HQ_ACCEL=
HQ_MAX=3
# GID der Gruppe „render“ auf dem Host:  getent group render
RENDER_GID=992

# --- Schnittstellen ----------------------------------------------------------
# off = HereSphere fest aus (sonst in der Oberfläche schaltbar)
HERESPHERE=
# 1 = Intiface-Weiterleitung fest nur Heimnetz (192.168.x / 10.x)
INTIFACE_LAN_ONLY=

# --- Container ---------------------------------------------------------------
# Benutzer im Container (Standard 1000 = „node“). Bei Änderung den Datenordner einmal umstellen:
#   docker run --rm -v <projekt>_handy-data:/d alpine chown -R <PUID>:<PGID> /d
PUID=1000
PGID=1000
TZ=Europe/Berlin
# debug = jede Anfrage in „docker logs“ (sonst nur langsame)
LOG_LEVEL=
