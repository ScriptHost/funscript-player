# Funscript Player – settings for docker-compose.yml
# Copy once:  cp .env.example .env   – from then on only edit the .env
# (an update never overwrites your .env, only this template).

# --- Address ------------------------------------------------------------------
# Port on the server: http://<server>:8080. With a reverse proxy (HTTPS) e.g. https://funscript-player.example.com
PLAYER_PORT=8080
# Who can reach the player (pick one):
#   0.0.0.0   = whole home network, open http://<server>:8080 in the browser (default)
#   127.0.0.1 = only through a reverse proxy on this server (recommended with HTTPS / internet access)
PLAYER_BIND=0.0.0.0
# Image version: latest = newest release; pinned, e.g. 1.19.9; edge = newest tested state of main (no release)
PLAYER_VERSION=latest

# --- Login to the player – REQUIRED since 2.0 ------------------------------------
# Without a login everyone who reaches the player sees your library and your Handy connection key.
# Set a user name and password here (recommended) – CHANGE the example password,
# with "change-me" the player only shows a help page …
AUTH_USER=admin
AUTH_PASS=change-me
# … OR switch the login off on purpose (only if something else protects the player,
# e.g. a reverse proxy with its own login):  LOGIN=off
# With neither of the two the player only shows a page explaining this.
LOGIN=

# --- Stash --------------------------------------------------------------------
# Best directly over a shared Docker network, e.g. http://Stash:9999 (container name),
# otherwise the address where Stash is reachable
STASH_URL=https://stash.example.com
# Only needed if Stash requires a login
STASH_API_KEY=
# 1 = accept a self-signed certificate from Stash
STASH_INSECURE=

# --- Media folders -----------------------------------------------------------
# Optional (without folders: Stash only): becomes /media/Filme – also enable the matching line
# under volumes in docker-compose.yml. More folders work the same way.
# MEDIA_FILME=/srv/media/movies
# MEDIA_DOWNLOADS=/srv/downloads
# MEDIA_VR=/srv/media/vr

# --- HQ stream (Intel graphics) ------------------------------------------------
# vaapi = Intel graphics, cpu = processor, empty = automatic
HQ_ACCEL=
HQ_MAX=2
# At most this much memory for the player (e.g. 1g, 2g) – protects Stash and other containers
PLAYER_MEM=2g
# Only with Intel graphics (enable /dev/dri in docker-compose.yml): GID of the "render" group on the host:  getent group render
RENDER_GID=992

# --- Interfaces ----------------------------------------------------------------
# off = HereSphere permanently off (otherwise switchable in the interface; off by default since 2.0)
HERESPHERE=
# 1 = Intiface relay locked to the home network (192.168.x / 10.x) – already the default, this only makes it unchangeable
INTIFACE_LAN_ONLY=
# Allowed Intiface ports (default 12345, several separated by commas)
INTIFACE_PORTS=

# --- Container -----------------------------------------------------------------
# User inside the container (default 1000 = "node"). If you change it, switch the data folder over once:
#   docker run --rm -v funscript-data:/d alpine chown -R <PUID>:<PGID> /d
PUID=1000
PGID=1000
TZ=Europe/Berlin
# debug = every request in "docker logs" (otherwise only slow ones)
LOG_LEVEL=
# off = never ask GitHub for a newer version (no "update available" note)
UPDATE_CHECK=
