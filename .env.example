# Funscript Player – Einstellungen für docker-compose.yml
# Einmal kopieren:  cp .env.example .env   – danach nur noch die .env bearbeiten
# (ein neues Update überschreibt deine .env nie, nur diese Vorlage).

# --- Adresse ---------------------------------------------------------------
# Port auf dem Server: http://<server>:8080. Mit Reverse Proxy (HTTPS) z. B. https://funscript-player.example.com
PLAYER_PORT=8080
# Image-Version: latest = immer die neueste; oder fest, z. B. 1.19.3
PLAYER_VERSION=latest

# --- Anmeldung im Player (leer = keine; dann hinter einem geschützten Proxy oder nur im Heimnetz betreiben) ---
AUTH_USER=
AUTH_PASS=

# --- Stash -----------------------------------------------------------------
# Am besten direkt über ein gemeinsames Docker-Netz, z. B. http://Stash:9999 (Containername),
# sonst die Adresse, unter der Stash erreichbar ist
STASH_URL=https://stash.example.com
# Nur nötig, wenn Stash eine Anmeldung hat
STASH_API_KEY=
# 1 = selbstsigniertes Zertifikat bei Stash akzeptieren
STASH_INSECURE=

# --- Medienordner ------------------------------------------------------------
# Optional (ohne Ordner nur Stash): wird zu /media/Filme – dazu in der docker-compose.yml die Zeile
# unter volumes einschalten. Weitere Ordner genauso.
# MEDIA_FILME=/srv/media/filme
# MEDIA_DOWNLOADS=/srv/downloads
# MEDIA_VR=/srv/media/vr

# --- HQ-Stream (Intel-Grafik) -----------------------------------------------
# vaapi = Intel-Grafik, cpu = Prozessor, leer = automatisch
HQ_ACCEL=
HQ_MAX=2
# Höchstens so viel Arbeitsspeicher für den Player (z. B. 1g, 2g) – schützt Stash und andere Container
PLAYER_MEM=2g
# GID der Gruppe „render“ auf dem Host:  getent group render
RENDER_GID=992

# --- Schnittstellen ----------------------------------------------------------
# off = HereSphere fest aus (sonst in der Oberfläche schaltbar)
HERESPHERE=
# 1 = Intiface-Weiterleitung fest nur Heimnetz (192.168.x / 10.x) – seit 1.19.5 ohnehin Standard, hier nur unveränderbar
INTIFACE_LAN_ONLY=
# Erlaubte Intiface-Ports (Standard 12345, mehrere mit Komma)
INTIFACE_PORTS=

# --- Container ---------------------------------------------------------------
# Benutzer im Container (Standard 1000 = „node“). Bei Änderung den Datenordner einmal umstellen:
#   docker run --rm -v <projekt>_handy-data:/d alpine chown -R <PUID>:<PGID> /d
PUID=1000
PGID=1000
TZ=Europe/Berlin
# debug = jede Anfrage in „docker logs“ (sonst nur langsame)
LOG_LEVEL=
