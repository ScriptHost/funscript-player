# Funscript Player – copy once:  cp .env.example .env   – then only edit .env (updates never overwrite it).

# ===== Required ==================================================================

# Login (required). Pick a user name and password – "change-me" does not count.
# Or leave both empty and set the login up on the player's first page.
AUTH_USER=admin
AUTH_PASS=change-me

# Stash: on/off. The address as seen from the container – on a shared Docker network the container name.
STASH=on
STASH_URL=http://Stash:9999
# Only if Stash has a login (Stash → Settings → Security → API key). Can also be set in ⚙️ → Library.
STASH_API_KEY=

# Video folders (optional): this folder is mounted as /media – every subfolder becomes a source.
# A video and its script share the name: Name.mp4 + Name.funscript
MEDIA=

# ===== Optional ==================================================================
# Remove the "#" to change a value.

# --- Address
# PLAYER_PORT=8080
# 0.0.0.0 = whole home network (default) · 127.0.0.1 = only through a reverse proxy on this server
# PLAYER_BIND=0.0.0.0
# latest = newest release · a fixed version, e.g. 2.0.0 · edge = newest tested state of main
# PLAYER_VERSION=latest

# --- Login
# off = no login (only if a reverse proxy with its own login protects the player)
# LOGIN=off
# 1 = remove a login set up in the interface (forgot it?) – restart, then remove the line again
# LOGIN_RESET=1

# --- Stash
# 1 = accept a self-signed certificate from Stash
# STASH_INSECURE=1
# Stash's video folder – only for extra scripts next to Stash videos (also enable the line in docker-compose.yml)
# MEDIA_STASH=/srv/stash/videos

# --- HQ stream
# vaapi = Intel graphics · cpu = processor · empty = automatic
# HQ_ACCEL=
# HQ_MAX=2
# GID of the host group "render" (getent group render) – only with /dev/dri enabled in docker-compose.yml
# RENDER_GID=992

# --- Interfaces
# off = HereSphere (VR) permanently off; otherwise it can be switched on in ⚙️ → VR & HereSphere
# HERESPHERE=off
# 1 = Intiface relay locked to the home network (already the default) · more ports, comma-separated
# INTIFACE_LAN_ONLY=1
# INTIFACE_PORTS=12345

# --- Container
# PUID=1000
# PGID=1000
# PLAYER_MEM=2g
# TZ=Europe/Berlin
# debug = log every request
# LOG_LEVEL=debug
# off = never ask GitHub for a newer version
# UPDATE_CHECK=off
